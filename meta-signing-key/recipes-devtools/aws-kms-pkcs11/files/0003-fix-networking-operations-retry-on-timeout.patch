diff --git a/util.cpp b/util.cpp
index 69592f5..26d34f4 100644
--- a/util.cpp
+++ b/util.cpp
@@ -1,4 +1,6 @@
 #include <optional>
+#include <cerrno>
+#include <cstdlib>
 #include <string.h>
 #include <stdlib.h>
 #include <stdio.h>
@@ -8,6 +10,40 @@
 #include <aws/core/Aws.h>
 #include <aws/core/client/ClientConfiguration.h>
 
+static const unsigned long DEFAULT_AWS_NETWORK_RETRIES = 10;
+
+static bool parse_retry_count(const char* env_var, unsigned long* retries) {
+    const char* value = getenv(env_var);
+    if (value == NULL || value[0] == '\0') {
+        return false;
+    }
+
+    char* end = NULL;
+    errno = 0;
+    const unsigned long parsed = std::strtoul(value, &end, 10);
+    if (value[0] == '-' || errno == ERANGE || end == value || *end != '\0') {
+        debug("Invalid %s value '%s'; ignoring it.", env_var, value);
+        return false;
+    }
+
+    *retries = parsed;
+    return true;
+}
+
+unsigned long get_aws_network_retries() {
+    unsigned long retries;
+    if (parse_retry_count("AWS_KMS_PKCS11_RETRIES", &retries)) {
+        return retries;
+    }
+    return DEFAULT_AWS_NETWORK_RETRIES;
+}
+
+bool is_aws_curl_timeout(const Aws::String& message) {
+    return message.find("curlCode: 28,") != Aws::String::npos ||
+           message.find("curlCode: 28;") != Aws::String::npos ||
+           message == "curlCode: 28";
+}
+
 Aws::Client::ClientConfiguration create_aws_config(std::string region) {
     Aws::Client::ClientConfiguration awsConfig;
 
diff --git a/util.h b/util.h
index 4cc36ee..8956dc7 100644
--- a/util.h
+++ b/util.h
@@ -3,8 +3,26 @@
 #include <aws/kms/KMSClient.h>
 #include <optional>
 
+#include "debug.h"
+
 Aws::Client::ClientConfiguration create_aws_config(std::string region);
 std::optional<Aws::Auth::AWSCredentials> create_credentials();
+unsigned long get_aws_network_retries();
+bool is_aws_curl_timeout(const Aws::String& message);
+
+template <typename Request>
+auto call_aws_with_retries(const char* operation, Request request) -> decltype(request()) {
+    const unsigned long retries = get_aws_network_retries();
+    debug("%s attempt 1.", operation);
+    auto outcome = request();
+    for (unsigned long retry = 0;
+         !outcome.IsSuccess() && is_aws_curl_timeout(outcome.GetError().GetMessage()) && retry < retries;
+         retry++) {
+        debug("%s retry %lu after curl timeout.", operation, retry + 1);
+        outcome = request();
+    }
+    return outcome;
+}
 
 template <typename Client>
 Client create_client(const std::string &region) {
